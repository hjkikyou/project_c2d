<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="contract">

    <select id="selectAll" resultType="com.comdog.c2d.dto.ContractListDto">
        SELECT * FROM contract
    </select>

    <delete id="deletePaymentByMemberId" parameterType="long">
        DELETE FROM payment_history 
        WHERE contract_id IN (SELECT contract_id FROM contract WHERE member_id = #{id})
    </delete>

    <delete id="deleteReviewByMemberId" parameterType="long">
        DELETE FROM review 
        WHERE contract_id IN (SELECT contract_id FROM contract WHERE member_id = #{id})
    </delete>

    <delete id="deleteByMemberId" parameterType="long">
        DELETE FROM contract 
        WHERE member_id = #{id}
    </delete>

</mapper>